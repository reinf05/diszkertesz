<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="diszkerteszClient.View.QuizPage"
             xmlns:model="clr-namespace:diszkerteszClient.Models"
             xmlns:viewmodel="clr-namespace:diszkerteszClient.Viewmodels"
             x:DataType="viewmodel:QuizViewModel"
             Title="{Binding Title}">
    <VerticalStackLayout
        Background="{AppThemeBinding Dark={StaticResource BackgroundDark}, Light={StaticResource SecondaryDark}}">

        <!-- Back button, only visible while a game is loaded -->
        <Button
            Text="← Vissza"
            Margin="10"
            HorizontalOptions="Start"
            Command="{Binding GoBackCommand}"
            IsVisible="{Binding IsLoaded}"/>

        <!-- Game type selector / starter -->
        <HorizontalStackLayout
            Spacing="10"
            Margin="10"
            HorizontalOptions="Center"
            IsVisible="{Binding IsNotLoaded}">
            <Button
                Text="Választós"
                Command="{Binding GetQuizCommand}"/>
            <Button
                Text="Kép alapján"
                Command="{Binding GetQuizNameCommand}"/>
        </HorizontalStackLayout>

        <!-- Multiple choice game -->
        <Grid
            ColumnDefinitions="*,*"
            RowDefinitions="*,*,*"
            RowSpacing="10"
            IsVisible="{Binding IsMultipleChoice}"
            x:DataType="viewmodel:QuizViewModel">
            <Image
                Source="{Binding Quiz.ChosenImage}"
                WidthRequest="300"
                HeightRequest="300"
                Aspect="AspectFill"
                Grid.Row="0"
                Grid.ColumnSpan="2"
                IsVisible="{Binding IsLoaded}"/>

            <CollectionView
                ItemsSource="{Binding Quiz.Names}"
                Grid.Row="1"
                Grid.ColumnSpan="2">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout
                        Orientation="Vertical"
                        Span="2"
                        HorizontalItemSpacing="10"
                        VerticalItemSpacing="10"/>
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Button
                            Text="{Binding .}"
                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:QuizViewModel}}, Path=GiveAnswerCommand}"
                            CommandParameter="{Binding .}"/>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <!-- Image-to-name (typed answer) game -->
        <VerticalStackLayout
            Spacing="10"
            Margin="10"
            IsVisible="{Binding IsImageToName}">
            <Image
                Source="{Binding QuizName.Image}"
                WidthRequest="300"
                HeightRequest="300"
                Aspect="AspectFill"
                HorizontalOptions="Center"
                IsVisible="{Binding IsLoaded}"/>

            <HorizontalStackLayout
                Spacing="10"
                HorizontalOptions="Center"
                IsVisible="{Binding IsLoaded}">
                <Entry
                    Placeholder="Latin név..."
                    WidthRequest="220"
                    Text="{Binding TypedAnswer}"/>
                <Button
                    Text="Submit"
                    Command="{Binding SubmitAnswerCommand}"/>
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </VerticalStackLayout>
</ContentPage>